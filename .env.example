APP_NAME=Maskanoor
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.tld

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Maskanoor_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_PREFIX=Maskanoor_cache_
LISTING_CACHE_STORE="${CACHE_DRIVER}"
LISTING_CACHE_TTL=60
FILESYSTEM_DISK=local
UPLOADS_DISK=public
PRIVATE_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=Maskanoor_session
APP_TIMEZONE=Asia/Karachi
SANCTUM_TOKEN_EXPIRATION=1440
SANCTUM_2FA_SETUP_MINUTES=15

# Comma-separated proxy IPs/CIDRs. Leave empty to trust none (recommended default).
TRUSTED_PROXIES=

BOOKING_HOLD_MINUTES=30

# SMS / OTP messaging (production must not use log unless explicitly allowed)
MESSAGING_DRIVER=http
MESSAGING_ALLOW_LOG_IN_PRODUCTION=false
MESSAGING_HTTP_URL=
MESSAGING_HTTP_KEY=
MESSAGING_HTTP_SENDER=

# Payment gateways (disabled until real HPP is wired)
PAYMENTS_JAZZCASH_ENABLED=false
PAYMENTS_EASYPAISA_ENABLED=false
BANK_TRANSFER_INSTRUCTIONS="Transfer to Maskanoor PKR account and upload proof."
JAZZCASH_SANDBOX=true
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_SANDBOX=true
EASYPAISA_STORE_ID=
EASYPAISA_SECRET=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=

CORS_ALLOWED_ORIGINS="${APP_URL}"

IMAGE_MAX_WIDTH=1920
IMAGE_QUALITY=82
BACKUP_KEEP=7

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=Maskanoor_database_

MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.tld
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@your-domain.tld"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Production checklist
# ---------------------------------------------------------------------------
# 1. php artisan key:generate
# 2. APP_ENV=production, APP_DEBUG=false, APP_URL=https://...
# 3. TRUSTED_PROXIES set to your load balancer CIDRs (not *)
# 4. MESSAGING_DRIVER=http with gateway credentials
# 5. QUEUE_CONNECTION + worker; CACHE/SESSION redis recommended
# 6. php artisan migrate --force && php artisan config:cache
# 7. php artisan storage:link; web root = /public
# For local development, copy .env.local.example instead.
# ---------------------------------------------------------------------------
