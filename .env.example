APP_NAME=LuxSecure
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luxsecure_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
# Prefer redis in production; database also works for listing query cache
CACHE_DRIVER=file
LISTING_CACHE_STORE="${CACHE_DRIVER}"
LISTING_CACHE_TTL=60
FILESYSTEM_DISK=local
# Public media disk (public|s3). Private docs/KYC/proofs use PRIVATE_DISK.
UPLOADS_DISK=public
PRIVATE_DISK=local
# Use database or redis; run: php artisan queue:work
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Payment gateways (sandbox defaults)
BANK_TRANSFER_INSTRUCTIONS="Transfer to LuxSecure PKR account and upload proof."
JAZZCASH_SANDBOX=true
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_SANDBOX=true
EASYPAISA_STORE_ID=
EASYPAISA_SECRET=

# Sentry (leave empty to disable)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# Comma-separated origins for API CORS (defaults to APP_URL when unset)
CORS_ALLOWED_ORIGINS="${APP_URL}"

IMAGE_MAX_WIDTH=1920
IMAGE_QUALITY=82
BACKUP_KEEP=7

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Production checklist
# ---------------------------------------------------------------------------
# 1. php artisan key:generate  (set a unique APP_KEY; never commit .env)
# 2. APP_ENV=production and APP_DEBUG=false
# 3. APP_URL=https://your-domain.tld  (and CORS_ALLOWED_ORIGINS to match)
# 4. SESSION_SECURE_COOKIE=true behind HTTPS; TrustHosts middleware enabled
# 5. Run migrations; create queue jobs table if needed: php artisan queue:table && migrate
# 6. QUEUE_CONNECTION=database (or redis) and run a queue worker
# 7. php artisan config:cache && php artisan route:cache && php artisan view:cache
# 8. php artisan storage:link
# 9. Point the web root to /public; deny access to .env
# ---------------------------------------------------------------------------
